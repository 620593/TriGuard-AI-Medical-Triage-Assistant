# ──────────────────────────────────────────────────────────────
#  TriGuard AI — Frontend Environment Variables (EXAMPLE)
#  Copy this file to .env and fill in your values.
# ──────────────────────────────────────────────────────────────

# Backend API base URL
# Local dev:   http://localhost:8000/api/v3
# Render prod: https://your-service-name.onrender.com/api/v3
VITE_API_URL=http://localhost:8000/api/v3

# Backend base URL (for static assets like audio/nutrition images)
# Local dev:   http://localhost:8000
# Render prod: https://your-service-name.onrender.com
VITE_BACKEND_URL=http://localhost:8000
