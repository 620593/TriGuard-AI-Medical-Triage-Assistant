# ────────────────────────────────────────────────────────────
#  TriGuard AI v6 — Environment Variables (EXAMPLE / TEMPLATE)
#  Copy this file to .env and fill in your real values.
# ────────────────────────────────────────────────────────────

# ── REQUIRED ─────────────────────────────────────────────────

# Groq API key — powers LLaMA LLM + Whisper STT
# Get yours at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# Tavily Search API key — medical information retrieval
# Get yours at: https://app.tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# Google Gemini API key — powers the nutrition_node (google-generativeai package)
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# MongoDB connection string
# Local: mongodb://localhost:27017
# Atlas: mongodb+srv://username:password@cluster.mongodb.net/triguard?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017

# ── OPTIONAL — External services ─────────────────────────────

# HuggingFace API token — for nutrition meal images + X-ray analysis
# Get yours at: https://huggingface.co/settings/tokens
HF_API_TOKEN=your_huggingface_api_token_here

# Twilio — emergency voice call escalation
# Get yours at: https://console.twilio.com
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_FROM_NUMBER=+1XXXXXXXXXX

# ── OPTIONAL — Emergency escalation ──────────────────────────

# Whether automatic Twilio call is placed on RED risk
AUTO_ESCALATION_ENABLED=false

# Default emergency contact phone number (E.164 format, e.g. +15551234567)
EMERGENCY_CONTACT_NUMBER=+1XXXXXXXXXX

# ── OPTIONAL — FAISS vector store ────────────────────────────

# Path to FAISS index file (relative to project root)
FAISS_INDEX_PATH=backend/data/disease_index.faiss

# Path to FAISS documents JSON file (relative to project root)
FAISS_DOCS_PATH=backend/data/disease_docs.json

# ── OPTIONAL — CORS ───────────────────────────────────────────

# Comma-separated allowed CORS origins
# Development: http://localhost:3000,http://localhost:5173
# Production (Vercel): https://your-app.vercel.app,https://yourcustomdomain.com
TRIGUARD_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# ── Auth ─────────────────────────────────────────────────────

# Secret key for JWT signing — use a strong random string in production
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_this_to_a_long_random_secret_in_production

# ── App configuration ─────────────────────────────────────────

# App environment — 'development' or 'production'
TRIGUARD_ENV=development

# Log level — DEBUG, INFO, WARNING, ERROR
TRIGUARD_LOG_LEVEL=INFO

# FastAPI server port
PORT=8000
